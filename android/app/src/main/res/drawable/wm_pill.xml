<?xml version="1.0" encoding="utf-8"?>
<!-- The count chip. Frosted rather than filled, so it belongs to the glass
     above it instead of sitting on it. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="20dp" />
            <solid android:color="@color/wm_accent_soft" />
            <stroke
                android:width="1dp"
                android:color="@color/wm_rim" />
        </shape>
    </item>
</layer-list>
