<?xml version="1.0" encoding="utf-8"?>
<!-- Adaptive icon: the launcher masks these two layers to whatever shape the
     device uses, and parallaxes the foreground against the background. The
     monochrome layer is what Android 13 and up tints for themed icons. -->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@mipmap/ic_launcher_background" />
    <foreground android:drawable="@mipmap/ic_launcher_foreground" />
    <monochrome android:drawable="@mipmap/ic_launcher_monochrome" />
</adaptive-icon>
