<?xml version="1.0" encoding="utf-8"?>
<!--
  Medium: 4x2. The face, a word from it, and where you are up to.

  The character has a fixed share of the width and the text column takes the
  rest, so shrinking this wraps the words rather than losing the mascot.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/wm_scene_mask"
    android:clipToOutline="true">

    <!-- The app's own sky, sun or moon, and tree — exported from the very
         same painter the header uses, because a widget cannot run one. The
         provider swaps it as the day goes on. -->
    <ImageView
        android:id="@+id/wm_scene"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        android:src="@drawable/wm_scene_day"
        android:importantForAccessibility="no" />

    <!-- The reflection and the edge, over the scene. -->
    <ImageView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:src="@drawable/wm_glass"
        android:importantForAccessibility="no" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="14dp">

        <ViewFlipper
            android:id="@+id/wm_mascot"
            android:layout_width="0dp"
            android:layout_weight="1.3"
            android:layout_height="match_parent"
            android:autoStart="true"
            android:flipInterval="300"
            android:measureAllChildren="true">

            <ImageView
                android:id="@+id/wm_f1"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:adjustViewBounds="true"
                android:scaleType="fitEnd"
                android:src="@drawable/wm_hero_1"
                android:importantForAccessibility="no" />

            <ImageView
                android:id="@+id/wm_f2"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:adjustViewBounds="true"
                android:scaleType="fitEnd"
                android:src="@drawable/wm_hero_2"
                android:importantForAccessibility="no" />

            <ImageView
                android:id="@+id/wm_f3"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:adjustViewBounds="true"
                android:scaleType="fitEnd"
                android:src="@drawable/wm_hero_3"
                android:importantForAccessibility="no" />

            <ImageView
                android:id="@+id/wm_f4"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:adjustViewBounds="true"
                android:scaleType="fitEnd"
                android:src="@drawable/wm_hero_4"
                android:importantForAccessibility="no" />

            <ImageView
                android:id="@+id/wm_f5"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:adjustViewBounds="true"
                android:scaleType="fitEnd"
                android:src="@drawable/wm_hero_5"
                android:importantForAccessibility="no" />

            <ImageView
                android:id="@+id/wm_f6"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:adjustViewBounds="true"
                android:scaleType="fitEnd"
                android:src="@drawable/wm_hero_6"
                android:importantForAccessibility="no" />

            <ImageView
                android:id="@+id/wm_f7"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:adjustViewBounds="true"
                android:scaleType="fitEnd"
                android:src="@drawable/wm_hero_7"
                android:importantForAccessibility="no" />

            <ImageView
                android:id="@+id/wm_f8"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:adjustViewBounds="true"
                android:scaleType="fitEnd"
                android:src="@drawable/wm_hero_8"
                android:importantForAccessibility="no" />

            <ImageView
                android:id="@+id/wm_f9"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:adjustViewBounds="true"
                android:scaleType="fitEnd"
                android:src="@drawable/wm_hero_9"
                android:importantForAccessibility="no" />

            <ImageView
                android:id="@+id/wm_f10"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:adjustViewBounds="true"
                android:scaleType="fitEnd"
                android:src="@drawable/wm_hero_10"
                android:importantForAccessibility="no" />
        </ViewFlipper>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_weight="1.9"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginStart="12dp">

            <TextView
                android:id="@+id/wm_line"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:maxLines="2"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="@color/wm_ink"
                android:text="Got a minute?"
                android:ellipsize="end"
                android:autoSizeTextType="uniform"
                android:autoSizeMinTextSize="12sp"
                android:autoSizeMaxTextSize="16sp"
                android:autoSizeStepGranularity="0.5sp" />

            <TextView
                android:id="@+id/wm_sub"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:maxLines="1"
                android:textSize="12sp"
                android:textColor="@color/wm_ink_soft"
                android:text="Open RewireMind"
                android:ellipsize="end"
                android:autoSizeTextType="uniform"
                android:autoSizeMinTextSize="9sp"
                android:autoSizeMaxTextSize="12sp"
                android:autoSizeStepGranularity="0.5sp" />

            <TextView
                android:id="@+id/wm_streak"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="@drawable/wm_pill"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:paddingTop="4dp"
                android:paddingBottom="4dp"
                android:maxLines="1"
                android:textSize="12sp"
                android:textStyle="bold"
                android:textColor="@color/wm_accent"
                android:text="Day 0 of 21"
                android:ellipsize="end"
                android:autoSizeTextType="uniform"
                android:autoSizeMinTextSize="10sp"
                android:autoSizeMaxTextSize="12sp"
                android:autoSizeStepGranularity="0.5sp" />

            <!-- Today, without having to read a number. This is the widest
                 size, so it is the one that carries the bar. -->
            <ProgressBar
                android:id="@+id/wm_progress"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="5dp"
                android:layout_marginTop="9dp"
                android:max="100"
                android:progress="0"
                android:progressTint="@color/wm_accent"
                android:progressBackgroundTint="@color/wm_rim" />

            <TextView
                android:id="@+id/wm_hint"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:visibility="gone"
                android:text="" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
