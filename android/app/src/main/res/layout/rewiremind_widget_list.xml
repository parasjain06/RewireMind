<?xml version="1.0" encoding="utf-8"?>
<!--
  Today's habits as a checklist, the finished ones struck through.

  Eight rows are laid out and the provider shows as many as the widget's
  height has room for, turning the last one into "+N more" when there are
  more habits than rows. A fixed set of rows rather than a ListView: a
  scrolling list needs a RemoteViewsService and a second process hop for what
  is, on any real day, five or six lines.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/wm_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/wm_panel_day">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingEnd="14dp"
        android:paddingTop="12dp"
        android:paddingBottom="10dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/wm_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-medium"
                android:textColor="@color/wm_on_light"
                android:textSize="16sp"
                android:text="Today" />

            <TextView
                android:id="@+id/wm_date"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="7dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="@color/wm_on_light_soft"
                android:textSize="12sp"
                android:text="Fri 11 Sep"
                android:autoSizeTextType="uniform"
                android:autoSizeMinTextSize="9sp"
                android:autoSizeMaxTextSize="12sp"
                android:autoSizeStepGranularity="0.5sp" />

            <TextView
                android:id="@+id/wm_count"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/wm_chip_l"
                android:fontFamily="sans-serif-medium"
                android:paddingStart="9dp"
                android:paddingEnd="9dp"
                android:paddingTop="3dp"
                android:paddingBottom="3dp"
                android:textColor="@color/wm_on_light_accent"
                android:textSize="11.5sp"
                android:text="2 of 5 done"
                android:autoSizeTextType="uniform"
                android:autoSizeMinTextSize="9sp"
                android:autoSizeMaxTextSize="11.5sp"
                android:autoSizeStepGranularity="0.5sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/wm_rows"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="vertical">

            <LinearLayout
                android:id="@+id/wm_r0"
                android:layout_width="match_parent"
                android:layout_height="26dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:visibility="visible">

                <ImageView
                    android:id="@+id/wm_r0_tick"
                    android:layout_width="17dp"
                    android:layout_height="17dp"
                    android:src="@drawable/wm_tick_on_l"
                    android:importantForAccessibility="no" />

                <TextView
                    android:id="@+id/wm_r0_text"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="9dp"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textColor="@color/wm_on_light_faint"
                    android:textSize="13.5sp"
                    android:text="Drink water" />
            </LinearLayout>
            <LinearLayout
                android:id="@+id/wm_r1"
                android:layout_width="match_parent"
                android:layout_height="26dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:visibility="visible">

                <ImageView
                    android:id="@+id/wm_r1_tick"
                    android:layout_width="17dp"
                    android:layout_height="17dp"
                    android:src="@drawable/wm_tick_on_l"
                    android:importantForAccessibility="no" />

                <TextView
                    android:id="@+id/wm_r1_text"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="9dp"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textColor="@color/wm_on_light_faint"
                    android:textSize="13.5sp"
                    android:text="Read 10 pages" />
            </LinearLayout>
            <LinearLayout
                android:id="@+id/wm_r2"
                android:layout_width="match_parent"
                android:layout_height="26dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:visibility="visible">

                <ImageView
                    android:id="@+id/wm_r2_tick"
                    android:layout_width="17dp"
                    android:layout_height="17dp"
                    android:src="@drawable/wm_tick_off_l"
                    android:importantForAccessibility="no" />

                <TextView
                    android:id="@+id/wm_r2_text"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="9dp"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textColor="@color/wm_on_light"
                    android:textSize="13.5sp"
                    android:text="Walk 20 min" />
            </LinearLayout>
            <LinearLayout
                android:id="@+id/wm_r3"
                android:layout_width="match_parent"
                android:layout_height="26dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:visibility="visible">

                <ImageView
                    android:id="@+id/wm_r3_tick"
                    android:layout_width="17dp"
                    android:layout_height="17dp"
                    android:src="@drawable/wm_tick_off_l"
                    android:importantForAccessibility="no" />

                <TextView
                    android:id="@+id/wm_r3_text"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="9dp"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textColor="@color/wm_on_light"
                    android:textSize="13.5sp"
                    android:text="Meditate" />
            </LinearLayout>
            <LinearLayout
                android:id="@+id/wm_r4"
                android:layout_width="match_parent"
                android:layout_height="26dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:visibility="visible">

                <ImageView
                    android:id="@+id/wm_r4_tick"
                    android:layout_width="17dp"
                    android:layout_height="17dp"
                    android:src="@drawable/wm_tick_off_l"
                    android:importantForAccessibility="no" />

                <TextView
                    android:id="@+id/wm_r4_text"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="9dp"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textColor="@color/wm_on_light"
                    android:textSize="13.5sp"
                    android:text="Journal" />
            </LinearLayout>
            <LinearLayout
                android:id="@+id/wm_r5"
                android:layout_width="match_parent"
                android:layout_height="26dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:visibility="gone">

                <ImageView
                    android:id="@+id/wm_r5_tick"
                    android:layout_width="17dp"
                    android:layout_height="17dp"
                    android:src="@drawable/wm_tick_off_l"
                    android:importantForAccessibility="no" />

                <TextView
                    android:id="@+id/wm_r5_text"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="9dp"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textColor="@color/wm_on_light"
                    android:textSize="13.5sp"
                    android:text="" />
            </LinearLayout>
            <LinearLayout
                android:id="@+id/wm_r6"
                android:layout_width="match_parent"
                android:layout_height="26dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:visibility="gone">

                <ImageView
                    android:id="@+id/wm_r6_tick"
                    android:layout_width="17dp"
                    android:layout_height="17dp"
                    android:src="@drawable/wm_tick_off_l"
                    android:importantForAccessibility="no" />

                <TextView
                    android:id="@+id/wm_r6_text"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="9dp"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textColor="@color/wm_on_light"
                    android:textSize="13.5sp"
                    android:text="" />
            </LinearLayout>
            <LinearLayout
                android:id="@+id/wm_r7"
                android:layout_width="match_parent"
                android:layout_height="26dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:visibility="gone">

                <ImageView
                    android:id="@+id/wm_r7_tick"
                    android:layout_width="17dp"
                    android:layout_height="17dp"
                    android:src="@drawable/wm_tick_off_l"
                    android:importantForAccessibility="no" />

                <TextView
                    android:id="@+id/wm_r7_text"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="9dp"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textColor="@color/wm_on_light"
                    android:textSize="13.5sp"
                    android:text="" />
            </LinearLayout>
        </LinearLayout>

        <TextView
            android:id="@+id/wm_empty"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:textColor="@color/wm_on_light_soft"
            android:textSize="13sp"
            android:visibility="gone"
            android:text="Nothing due today" />
    </LinearLayout>
</FrameLayout>
